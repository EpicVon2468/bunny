VERSION 0 0 0

//funct main(it: i32): i512;

type abc {
	define one: i32;
	define two: i32;
	define three: i64;
}

funct print_i32(zero: i32);
funct print_i64(zero: i64);

funct main(/*argc: i32, argv: **u8*/): i32 {
	define instance: abc = abc::new(1, 2, 3);
	define one: void = print_i32(instance.one);
	define two: void = print_i32(instance.two);
	define three: void = print_i64(instance.three);
	return 0;
}